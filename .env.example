# Copy to .env and fill in what you have. Every integration below degrades
# gracefully when its key is absent: Drishti runs fully locally with no keys
# at all (local CPU/GPU VLM + a small local instruct LLM), and each optional
# integration is only exercised live when its key is present. See
# docs/limitations.md for exactly what "Pending: needs credentials" covers.

# ---- Hugging Face (perception + local LLM model downloads) ----------------
# Only needed for gated models; the models this project ships with are open.
HUGGINGFACE_TOKEN=

# ---- Vector store -----------------------------------------------------------
# "milvus_lite" (default, embedded file, no services needed) or "milvus"
# (standalone via docker-compose) or "pinecone".
VECTOR_STORE_BACKEND=milvus_lite
# Deliberately NOT named MILVUS_URI — pymilvus reads that exact name itself
# for its own global default connection and expects an http(s) URI, which
# collides with a Milvus Lite local file path. See docs/limitations.md.
# Left unset here on purpose: backend/app/config.py defaults this (and the
# DATA_* / MEMORY_DB_PATH paths below) to an absolute path anchored at the
# repo root, which works regardless of the process's cwd. Uncomment and set
# only if you want to override that default (e.g. a custom data location).
# VECTOR_STORE_URI=/absolute/path/to/milvus_lite.db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=drishti-sops
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Observability (LangSmith) ----------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drishti
LANGSMITH_TRACING=false

# ---- Optional hosted LLM upgrade --------------------------------------------
# If set, agent reasoning (LangGraph nodes, AutoGen verifier, CrewAI crew)
# uses this provider instead of the local Qwen2.5-0.5B-Instruct model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Perception service ------------------------------------------------------
DEVICE=cpu
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
LOCAL_LLM_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# ---- Data paths (left unset — see note above) ----------------------------------
# DATA_SOPS_DIR=/absolute/path/to/data/sops
# DATA_IMAGES_DIR=/absolute/path/to/data/images
# DATA_LABELS_FILE=/absolute/path/to/data/labels/labels.jsonl
# MEMORY_DB_PATH=/absolute/path/to/data/memory/drishti.db

# ---- Services -------------------------------------------------------------------
DRONE_GATEWAY_URL=http://localhost:8100

# ---- Deployment (GCP) -------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=
