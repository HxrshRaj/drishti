data/raw_cache/
data/memory/*.db
data/memory/*.sqlite*

# Milvus / vector store local state
milvus_lite_data/
*.db-journal

# Logs, traces, benchmark artifacts (raw)
*.log
logs/
benchmarks/results/*.json
!benchmarks/results/.gitkeep

