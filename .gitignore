# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
.next/
out/
frontend/.env.local

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Model weights / caches
*.safetensors
*.bin
!drone-gateway/**/*.bin
.cache/
hf_cache/
models/weights/

# Data: the sampled VisDrone subset (data/images, data/labels) IS committed for
# reproducibility — see docs/data.md for license (CC BY-NC-SA 3.0, non-commercial).
# Only raw/full dataset downloads and local runtime state are ignored below.
data/raw_cache/
data/memory/*.db
data/memory/*.sqlite*

# Milvus / vector store local state (data/milvus_lite.db is a directory in
# recent milvus-lite versions, not a single file)
milvus_lite_data/
data/milvus_lite.db/
data/milvus_lite.db
*.db-journal

# Logs, traces (benchmarks/results/*.{json,jsonl} ARE committed — they're
# the real evidence backing docs/benchmarks.md, docs/bias-report.md, and
# the frontend Metrics page; see benchmarks/results/ for the reproduce
# commands in docs/benchmarks.md)
*.log
logs/

# Claude Code local dev-preview tooling (machine-specific, not part of
# the deliverable)
.claude/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker
docker-compose.override.yml
